+            val values = url.queryParameterValues(name).filterNotNull()
+            if (values.isNotEmpty()) {
+                // The browse URL carries `content_rating` as one comma-joined
+                // value, but the API expects it as a `content_rating[]` array.
+                if (name == "content_rating") {
