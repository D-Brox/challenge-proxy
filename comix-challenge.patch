+        val body = response.body.string()
+        response.close()
+        if (response.code == 403 &&
+            (
+                body.contains("Invalid token", ignoreCase = true) ||
+                    body.contains("Missing token", ignoreCase = true)
+                )
+        ) {
+            throw CipherRotatedException(body.take(160))
+        }
+        if (!response.isSuccessful) {
+            throw Exception("API returned ${response.code}")
+        }
+        return decodeSignal(body)
+    }
+
+    /** Passes plaintext responses through; asks the proxy to decrypt an `"e"` envelope if present. */
+    private fun decodeSignal(body: String): String {
+        val root = runCatching { body.parseAs<JsonObject>() }.getOrNull()
+            ?: return body
+        val e = root["e"] as? JsonPrimitive ?: return body
+        return proxyServer()?.let { proxyDecrypt(it, e.content) }
+            ?: throw CipherRotatedException("decrypt failed")
+    }
+
+    private fun nativeMangaList(request: Request): MangasPage? = withProxy {
+        val response = executeSigned("/api/v1/manga", nativeMangaParams(request.url))
+        val items = responseBodyOrThrow(response).parseAs<SearchResponse>().result
+        MangasPage(
+            items.items.map { it.toBasicSManga(preferences.posterQuality()) },
+            items.hasNextPage(),
+        )
+    }
+
+    private fun nativeChapterList(manga: SManga): List<SChapter>? {
+        val mangaSlug = manga.url.removePrefix("/")
+        val hid = mangaSlug.substringBefore("-").takeIf { it.isNotBlank() } ?: return null
+        return withProxy {
+            val allChapters = mutableListOf<Chapter>()
+            var page = 1
+            while (page <= NATIVE_MAX_CHAPTER_PAGES) {
+                val params = linkedMapOf(
+                    "page" to listOf(page.toString()),
+                    "limit" to listOf("100"),
+                    "order[number]" to listOf("desc"),
+                )
+                val response = executeSigned("/api/v1/manga/$hid/chapters", params)
+                val result = responseBodyOrThrow(response).parseAs<ChapterDetailsResponse>().result
+                allChapters += result.items
+                if (!result.hasNextPage() || result.items.isEmpty()) break
+                page++
+            }
+            buildChapters(allChapters, mangaSlug)
+        }
+    }
+
+    private fun nativePageList(chapter: SChapter): List<Page>? {
+        val cid = PAGE_ID_REGEX.find(chapter.url)?.groupValues?.get(1) ?: return null
+        return withProxy {
+            val response = executeSigned("/api/v1/chapters/$cid", emptyMap())
+            buildPages(responseBodyOrThrow(response).parseAs<ChapterResponse>())
+        }
+    }
