+    private fun <T> withProxy(block: () -> T): T? {
+        val proxy = proxyServer() ?: return null
+        return try {
+            block()
+        } catch (e: CipherRotatedException) {
+            refreshProxyMaterial(proxy)
+            try {
+                block()
+            } catch (e2: Exception) {
+                null
+            }
+        } catch (e: Exception) {
